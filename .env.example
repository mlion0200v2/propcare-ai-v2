# Copy to .env.local for local development. Never commit real values.

# Supabase (use a local or staging project, never production, for development)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=propcare-kb

# Public base URL: used in invite emails, tenant links (/r/<token>) and QR posters
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend). Without RESEND_API_KEY, or with EMAIL_DRY_RUN=1, emails are
# logged instead of sent. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="PropCare <noreply@example.com>"
EMAIL_DRY_RUN=1
# Last-resort recipient for ticket emails when a workspace has no team email
FALLBACK_MANAGER_EMAIL=

# Tenant link one-time codes: HMAC secret (32+ random characters)
INTAKE_CODE_SECRET=

# Try mode (/try, no sign-up). Off unless 1.
DEMO_MODE=
DEMO_CHAT_TURN_LIMIT=40
# Authorises GET /api/demo/cleanup (Bearer token)
CRON_SECRET=
